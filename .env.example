# Exemplo de env file para o container.
# Uso: docker run --rm -it --env-file ./env/meurepo scm-runtime:latest
# Não use aspas nem `export`: o --env-file do docker lê o valor literal.

# Tipo do servidor Git: onedev, gitlab ou github (obrigatório)
GIT_SERVER_TYPE=github

# URL do repositório a clonar em /workspace (obrigatório)
GIT_REPO_URL=https://github.com/org/repo.git

# Token de acesso, usado como senha pelo credential helper (obrigatório).
# Fica só no ambiente, nunca é gravado em disco.
GIT_TOKEN=xyz--zzz

# Usuário enviado junto com o token (opcional, padrão: git).
# Alguns forges exigem um nome específico.
#GIT_USERNAME=git

# Branch que será clonada, base da branch de trabalho (obrigatório)
GIT_BASE_BRANCH=main

# Branch de trabalho (obrigatório se ISSUE_ID não estiver definido). Se já existir no remoto, é usada;
# se não, é criada a partir de GIT_BASE_BRANCH.
GIT_BRANCH=agent/minha-tarefa

# ID da issue (opcional). Quando definido, sobrescreve GIT_BRANCH
# e a branch de trabalho passa a ser issue/<ISSUE_ID>.
#ISSUE_ID=123

# Modo autônomo (opcional): true indica que o container roda sem interação humana.
# Exige ISSUE_ID definido; o entrypoint aborta se faltar.
#AUTONOMOUS_MODE=true

# Identidade dos commits (obrigatório)
GIT_USER_NAME=MyAgent
GIT_USER_EMAIL=myagent@example.com

# Co-autor humano dos commits (opcional). Quando definido, adiciona o trailer
# "Co-authored-by: ..." automaticamente via hook global prepare-commit-msg.
GIT_CO_AUTHOR=Some human <somehuman@example.com>
